# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=

# Model slots (CLAUDE.md §7 "Model routing"). IDs verified against
# docs.claude.com on 2026-09-10; only config.py reads these.
#   Triage: fast + cheap, classifies every post.
#   Review: stronger, used near the threshold, for dedup, and summary merges.
TRIAGE_MODEL=claude-haiku-4-5
REVIEW_MODEL=claude-opus-5

# Telegram via telethon (MTProto) - preferred, works for any public channel.
# Get these at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram Bot API long-poll fallback - only sees channels the bot is an admin of.
TELEGRAM_BOT_TOKEN=

# TwitterAPI.io key (https://twitterapi.io dashboard) - the DEFAULT X source.
# Filter rules for your configured accounts are created/updated automatically.
X_PUSH_API_KEY=

# Official X API (pay-per-use polling) - budget-capped FALLBACK only.
# Set this and flip x_api.enabled in config.yaml if the push vendor is down.
X_BEARER_TOKEN=
